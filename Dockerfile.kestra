ARG KESTRA_VERSION=v1.3.30
ARG KESTRA_SCRIPT_SHELL_PLUGIN_VERSION=1.9.9

FROM ghcr.io/astral-sh/uv:0.8.22 AS uv
FROM kestra/kestra:${KESTRA_VERSION}

ARG KESTRA_SCRIPT_SHELL_PLUGIN_VERSION

USER root
COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock /opt/foodmind/
RUN cd /opt/foodmind && uv sync --frozen --no-dev
RUN /app/kestra plugins install io.kestra.plugin:plugin-script-shell:${KESTRA_SCRIPT_SHELL_PLUGIN_VERSION}

COPY app /workspace/app
COPY cmd /workspace/cmd
COPY infra/kestra/flows /workspace/infra/kestra/flows

ENV PATH="/opt/foodmind/.venv/bin:${PATH}" PYTHONPATH="/workspace"
WORKDIR /workspace
