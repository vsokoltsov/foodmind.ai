# Elasticsearch endpoint used by the ingestion CLI and Kestra workers.
ELASTICSEARCH_URL=http://localhost:9200
DATABASE_URL=postgresql+psycopg://foodmind:foodmind@localhost:5432/foodmind

# Local application PostgreSQL container.
APP_POSTGRES_DB=foodmind
APP_POSTGRES_USER=foodmind
APP_POSTGRES_PASSWORD=foodmind
KESTRA_POSTGRES_DB=kestra
KESTRA_POSTGRES_USER=kestra
KESTRA_POSTGRES_PASSWORD=kestra

# OpenAI credentials and model used by cmd/agent.py.
OPENAI_API_KEY=
OPENAI_MODEL=openai:gpt-5-mini
# Optional model tiers. Unset values fall back to OPENAI_MODEL.
OPENAI_PLANNER_MODEL=
OPENAI_AGENT_MODEL=
OPENAI_SYNTHESIS_MODEL=

# Bounded latency for interactive chat requests.
PLANNER_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=120
SYNTHESIS_TIMEOUT_SECONDS=60
RETRIEVAL_TIMEOUT_SECONDS=5
MAX_RETRIEVAL_RESULTS=10

# OpenTelemetry exports API and agent traces to Tempo over OTLP/HTTP.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=foodmind-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=10

# Required to sign NiceGUI's browser-session cookie. Change this outside local development.
NICEGUI_STORAGE_SECRET=foodmind-local-ui-secret

# Artifact storage backend. Keep `local` for development without GCP.
INGESTION_ARTIFACT_STORAGE=local

# Required when INGESTION_ARTIFACT_STORAGE=gcs. The bucket is created by
# infra/terraform and should be globally unique.
GCS_BUCKET=
GCS_PREFIX=foodmind/ingestion
GCP_PROJECT_ID=

# Versioned evaluation strategy artifacts (Cloud Storage).
EVALUATION_ARTIFACT_BUCKET=
EVALUATION_ARTIFACT_PREFIX=foodmind/evaluation

# Path inside the Kestra container to the locally mounted ./gcp.json file.
GOOGLE_APPLICATION_CREDENTIALS=/var/secrets/gcp/gcp.json

# Optional Kestra UI credentials (the Compose defaults work for local use).
KESTRA_BASIC_AUTH_USERNAME=admin@foodmind.local
KESTRA_BASIC_AUTH_PASSWORD=Foodmind123
# Compose maps these service-specific values to each process's DATABASE_URL.
KESTRA_DATABASE_URL=postgresql+psycopg://kestra:kestra@kestra-postgres:5432/kestra
API_DATABASE_URL=postgresql+psycopg://foodmind:foodmind@app-postgres:5432/foodmind
